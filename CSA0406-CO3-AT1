#include <stdio.h>

int main() {
    int base, limit, logical_addr;

    // Take inputs for memory constraints
    printf("Enter Base Register: ");
    scanf("%d", &base);
    printf("Enter Limit Register: ");
    scanf("%d", &limit);
    
    printf("Enter Logical Address to access: ");
    scanf("%d", &logical_addr);

    // Memory Protection Check
    if (logical_addr >= 0 && logical_addr < limit) {
        printf("\n[SUCCESS] Access Granted!\n");
        printf("Mapped Physical Address: %d\n", base + logical_addr);
    } else {
        printf("\n[ERROR] Access Denied! Segmentation Fault.\n");
        printf("Unauthorized access blocked: Address falls outside the valid limit.\n");
    }

    return 0;
}

