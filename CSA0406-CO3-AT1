#include <stdio.h>

int main() {
    float hit_ratio, tlb_time, mem_time;
    float emat_with_tlb, emat_without_tlb;

    // Take inputs
    printf("Enter TLB hit ratio (e.g., 0.8 for 80%%): ");
    scanf("%f", &hit_ratio);
    
    printf("Enter TLB access time (ns): ");
    scanf("%f", &tlb_time);
    
    printf("Enter Main Memory access time (ns): ");
    scanf("%f", &mem_time);

    // EMAT without TLB (2 memory accesses: 1 for page table, 1 for actual data)
    emat_without_tlb = 2 * mem_time;

    // EMAT with TLB
    emat_with_tlb = (hit_ratio * (tlb_time + mem_time)) + 
                    ((1.0 - hit_ratio) * (tlb_time + 2 * mem_time));

    // Display results
    printf("\n--- Effective Memory Access Time (EMAT) ---\n");
    printf("Without TLB : %.2f ns\n", emat_without_tlb);
    printf("With TLB    : %.2f ns\n", emat_with_tlb);
    printf("Performance Improvement (Time saved): %.2f ns\n", emat_without_tlb - emat_with_tlb);

    return 0;
}

OUTPUT:
Enter TLB hit ratio (e.g., 0.8 for 80%): 0.85
Enter TLB access time (ns): 20
Enter Main Memory access time (ns): 100

--- Effective Memory Access Time (EMAT) ---
Without TLB : 200.00 ns
With TLB    : 135.00 ns
Performance Improvement (Time saved): 65.00 ns

