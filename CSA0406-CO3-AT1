#include <stdio.h>

int main() {
    int page_size, n_pages, logical_addr, page_table[100];

    // Take inputs
    printf("Enter page size and number of pages: ");
    scanf("%d %d", &page_size, &n_pages);
    
    printf("Enter frame number for each page (-1 if not in memory):\n");
    for (int i = 0; i < n_pages; i++) {
        printf("Page %d: ", i);
        scanf("%d", &page_table[i]);
    }

    printf("Enter Logical Address: ");
    scanf("%d", &logical_addr);

    // Compute page number (p) and offset (d)
    int p = logical_addr / page_size;
    int d = logical_addr % page_size;

    // Validate and translate
    if (p < n_pages && p >= 0 && page_table[p] != -1) {
        printf("\nTranslation: Page %d -> Frame %d\n", p, page_table[p]);
        printf("Physical Address = %d\n", (page_table[p] * page_size) + d);
    } else {
        printf("\nError: Page Fault or Invalid Address!\n");
    }

    return 0;
}


