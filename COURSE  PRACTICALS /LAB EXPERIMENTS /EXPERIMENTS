    // 1. open, fcntl, lseek
    fd = open("demo.txt", O_CREAT | O_RDWR, 0644);
    write(fd, "0123456789", 10);

    // Seek offset using lseek
    pos = lseek(fd, 5, SEEK_SET);
    printf("Current file offset position: %ld\n", (long)pos);

    // Get file flags using fcntl
    printf("fcntl file descriptor status: %d\n", fcntl(fd, F_GETFL));
    close(fd);

    // 2. stat system call
    if (stat("demo.txt", &file_stat) == 0) {
        printf("File Size: %ld bytes\n", (long)file_stat.st_size);
    }

    // 3. opendir and readdir system calls
    printf("\nDirectory contents of current directory (.):\n");
    dir = opendir(".");
    if (dir != NULL) {
        while ((entry = readdir(dir)) != NULL) {
            printf("%s\n", entry->d_name);
        }
        closedir(dir);
    }

    return 0;
}
