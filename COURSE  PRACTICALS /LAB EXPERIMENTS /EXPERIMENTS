#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <unistd.h>
#include <sys/wait.h>
struct message_buffer {
    long message_type;
    char message_text[100];
};
int main() {
    key_t key = ftok("progfile", 65);
    int msgid = msgget(key, 0666 | IPC_CREAT);
    pid_t pid = fork();
    if (pid == 0) {
        // Child Process: Receiver
        struct message_buffer rcv_msg;
        msgrcv(msgid, &rcv_msg, sizeof(rcv_msg.message_text), 1, 0);
        printf("Receiver Process: Data Received -> \"%s\"\n", rcv_msg.message_text);
        exit(0);
    } else {
        // Parent Process: Sender
        struct message_buffer snd_msg;
        snd_msg.message_type = 1;
        strcpy(snd_msg.message_text, "Hello from Message Queue!");
        msgsnd(msgid, &snd_msg, sizeof(snd_msg.message_text), 0);
        printf("Sender Process: Data Sent successfully.\n");
        
        wait(NULL);
        msgctl(msgid, IPC_RMID, NULL);
    }
    return 0;
}
