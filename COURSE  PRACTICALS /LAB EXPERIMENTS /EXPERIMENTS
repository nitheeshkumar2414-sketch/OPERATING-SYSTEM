#include <stdio.h>
int main() {
    int n, p[20], bt[20], wt[20], tat[20], pos, temp;
    float wt_avg = 0, tat_avg = 0;
    printf("Enter total number of processes: ");
    scanf("%d", &n);
    for (int i = 0; i < n; i++) {
        p[i] = i + 1;
        printf("Enter Burst Time for P%d: ", p[i]);
        scanf("%d", &bt[i]);
    }
    // Sorting burst times and process IDs in ascending order
    for (int i = 0; i < n; i++) {
        pos = i;
        for (int j = i + 1; j < n; j++) {
            if (bt[j] < bt[pos]) pos = j;
        }
        temp = bt[i]; bt[i] = bt[pos]; bt[pos] = temp;
        temp = p[i]; p[i] = p[pos]; p[pos] = temp;
    }
    wt[0] = 0;
    tat[0] = bt[0];
    for (int i = 1; i < n; i++) {
        wt[i] = wt[i - 1] + bt[i - 1];
        tat[i] = wt[i] + bt[i];
    }
    printf("\nProcess\tBurst Time\tWaiting Time\tTurnaround Time\n");
    for (int i = 0; i < n; i++) {
        wt_avg += wt[i];
        tat_avg += tat[i];
        printf("P%d\t\t%d\t\t%d\t\t%d\n", p[i], bt[i], wt[i], tat[i]);
    }
    printf("\nAverage Waiting Time = %.2f", wt_avg / n);
    printf("\nAverage Turnaround Time = %.2f\n", tat_avg / n);
    return 0;
}
