#include <stdlib.h>
#include <pthread.h>
#include <unistd.h>
// Function executed by Thread 1
void* thread_function_one(void* arg) {
    for (int i = 1; i <= 3; i++) {
        printf("Thread 1 is running: Step %d\n", i);
        sleep(1); // Pause for 1 second
    }
    printf("Thread 1 finished execution.\n");
    return NULL;
}
// Function executed by Thread 2
void* thread_function_two(void* arg) {
    for (int i = 1; i <= 3; i++) {
        printf("Thread 2 is running: Step %d\n", i);
        sleep(1); // Pause for 1 second
    }
    printf("Thread 2 finished execution.\n");
    return NULL;
}
int main() {
    pthread_t t1, t2;
    printf("Main thread: Starting execution and creating threads...\n");
    // Create Thread 1
    if (pthread_create(&t1, NULL, thread_function_one, NULL) != 0) {
        perror("Failed to create thread 1");
        return 1;
    }
    // Create Thread 2
    if (pthread_create(&t2, NULL, thread_function_two, NULL) != 0) {
        perror("Failed to create thread 2");
        return 1;
    }
    // Wait for Thread 1 and Thread 2 to finish execution
    pthread_join(t1, NULL);
    pthread_join(t2, NULL);
    printf("Main thread: Both threads have finished. Exiting program.\n");
    return 0;
}
