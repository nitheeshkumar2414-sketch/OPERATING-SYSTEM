    for (i = 0; i < n; i++) {
        p[i] = i + 1;
        printf("Enter Burst Time for P%d: ", p[i]);
        scanf("%d", &bt[i]);
    }

    // Sort processes according to Burst Time using Selection Sort
    for (i = 0; i < n; i++) {
        pos = i;
        for (j = i + 1; j < n; j++) {
            if (bt[j] < bt[pos]) {
                pos = j;
            }
        }
        
        // Swap Burst Times
        temp = bt[i];
        bt[i] = bt[pos];
        bt[pos] = temp;

        // Swap Process IDs
        temp = p[i];
        p[i] = p[pos];
        p[pos] = temp;
    }

    // Calculate Waiting Time and Turnaround Time
    wt[0] = 0;
    tat[0] = bt[0];

    for (i = 1; i < n; i++) {
        wt[i] = wt[i - 1] + bt[i - 1];
        tat[i] = wt[i] + bt[i];
