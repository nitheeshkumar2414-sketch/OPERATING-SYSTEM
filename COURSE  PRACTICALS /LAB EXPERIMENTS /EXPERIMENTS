int main() {
    int f, p;
    int pages[25], frame[10], count[10], flag[25];
    int i, j, k, mint, pos = 0, pf = 0;
    printf("Enter number of frames: ");
    scanf("%d", &f);
    printf("Enter number of pages: ");
    scanf("%d", &p);
    printf("Enter reference string (page values): ");
    for (i = 0; i < p; i++) {
        scanf("%d", &pages[i]);
        flag[i] = 0;
    }
    for (i = 0; i < f; i++) {
        frame[i] = -1;
    }
    for (i = 0; i < p; i++) {
        flag[i] = 0;
        // Check if page already exists in frame
        for (j = 0; j < f; j++) {
            if (frame[j] == pages[i]) {
                flag[i] = 1;
                count[j] = i; // update usage timestamp
                break;
            }
        }
        // If page fault occurs and there's an empty frame
        if (flag[i] == 0) {
            for (j = 0; j < f; j++) {
                if (frame[j] == -1) {
                    frame[j] = pages[i];
                    count[j] = i;
                    pf++;
                    flag[i] = 1;
                    break;
                }
            }
        }
        // If page fault occurs and frames are full -> replace LRU
        if (flag[i] == 0) {
            mint = count[0];
            pos = 0;
            for (j = 1; j < f; j++) {
                if (count[j] < mint) {
                    mint = count[j];
                    pos = j;
                }
            }
            frame[pos] = pages[i];
            count[pos] = i;
            pf++;
        }
        printf("\nAfter adding %d: ", pages[i]);
        for (k = 0; k < f; k++) {
            if (frame[k] != -1)
                printf("%d ", frame[k]);
            else
                printf("- ");
        }
    }
    printf("\n\nTotal Number of Page Faults: %d\n", pf);
    return 0;
}


